# Punjab Analysis System - GitIgnore
# Kubernetes Airflow Deployment
# Exclude sensitive data, deprecated files, and generated files from version control

# ===== SENSITIVE DATA =====
# Database credentials in root secrets/ (k8s/secrets/ is kept for deployment)
secrets/
*.env
.env*
# !k8s/secrets/

# ===== DEPRECATED FILES (OLD APPROACH) =====
# Docker Compose files (now using Kubernetes)
docker-compose.yml
docker-compose.override.yml

# Old DAG files
airflow/dags/punjab_analysis_docker_dag.py
airflow/dags/punjab_analysis_kubernetes_test_dag.py

# Duplicate/test files
k8s/punjab_analysis_kubernetes_dag.py
k8s/04-postgres-external-service.yaml

# Old documentation
README_OLD.md

# API client (optional - remove if not used)
api-client/

# Postman collection (optional)
postmancollection.json

# ===== DATA FILES =====
# Local data storage (using K8s PVCs instead)
data/
output/
local-reports/

# CSV data files (can be large and contain sensitive data)
*.csv

# Analysis reports
*.xlsx

# Temporary viewer files
/tmp/viewer-pod.yaml
cleanup-project.sh
kubernetes-airflow-files-analysis.md

# ===== AIRFLOW LOGS & CACHE =====
# Airflow logs (can be very large)
airflow/logs/
airflow/logs/*

# Airflow database
airflow.db
airflow.cfg

# Airflow plugins cache
airflow/plugins/__pycache__/

# ===== DOCKER & SYSTEM =====
# Docker volumes and containers data
.docker/

# System files
.DS_Store
Thumbs.db
*.tmp
*.temp

# ===== CLAUDE CODE =====
# Claude-specific files
.claude/

