                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns", "{{dag_run_id}}", "taskInstances"]
                        },
                        "description": "Get status of all tasks (start_pipeline, extract_data, analyze_data, pipeline_complete, cleanup_processed_data)"
                    }
                },
                {
                    "name": "Get Task Instance - Start Pipeline",
                    "request": {
                        "method": "GET",
                        "header": [
