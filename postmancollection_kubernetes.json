{
    "info": {
        "name": "Punjab Analysis Kubernetes DAG - Airflow API",
        "_postman_id": "k8s-punjab-analysis-2025",
        "description": "Complete collection of Airflow REST API endpoints for monitoring and managing the Punjab Analysis Kubernetes Pipeline",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. DAG Management",
            "item": [
                {
                    "name": "Get DAG Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}"]
                        },
                        "description": "Get DAG configuration, tasks, and metadata"
                    }
                },
                {
                    "name": "Pause/Unpause DAG",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"is_paused\": false\n}"
                        },
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}"]
                        },
                        "description": "Set is_paused to true to pause, false to unpause"
                    }
                }
            ]
        },
        {
            "name": "2. DAG Run Triggers",
            "item": [
                {
                    "name": "Trigger DAG - Single Tenant",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"dag_run_id\": \"api_run_adampur_{{$timestamp}}\",\n  \"conf\": {\n    \"tenant_ids\": [\"pb.adampur\"]\n  }\n}"
                        },
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns"]
                        },
                        "description": "Trigger DAG for a single tenant (pb.adampur)"
                    }
                },
                {
                    "name": "Trigger DAG - Multiple Tenants",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"dag_run_id\": \"api_run_multi_{{$timestamp}}\",\n  \"conf\": {\n    \"tenant_ids\": [\"pb.adampur\", \"pb.samana\", \"pb.amloh\"]\n  }\n}"
                        },
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns"]
                        },
                        "description": "Trigger DAG for multiple tenants"
                    }
                },
                {
                    "name": "Trigger DAG - All Default Tenants",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"dag_run_id\": \"api_run_default_{{$timestamp}}\"\n}"
                        },
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns"]
                        },
                        "description": "Trigger with no conf - uses default tenants from DAG params"
                    }
                }
            ]
        },
        {
            "name": "3. DAG Run Monitoring",
            "item": [
                {
                    "name": "Get DAG Run Status",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns/{{dag_run_id}}",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns", "{{dag_run_id}}"]
                        },
                        "description": "Get status, execution_date, state (running/success/failed)"
                    }
                },
                {
                    "name": "List Recent DAG Runs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns?limit=10&order_by=-execution_date",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns"],
                            "query": [
                                {"key": "limit", "value": "10"},
                                {"key": "order_by", "value": "-execution_date"}
                            ]
                        },
                        "description": "Get last 10 DAG runs ordered by execution date"
                    }
                },
                {
                    "name": "List Failed DAG Runs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Basic {{auth}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{airflow_url}}/api/v1/dags/{{dag_id}}/dagRuns?state=failed&limit=10",
                            "host": ["{{airflow_url}}"],
                            "path": ["api", "v1", "dags", "{{dag_id}}", "dagRuns"],
                            "query": [
                                {"key": "state", "value": "failed"},
                                {"key": "limit", "value": "10"}
                            ]
                        },
                        "description": "Get failed DAG runs for troubleshooting"
                    }
                }
            ]
        },
        {
